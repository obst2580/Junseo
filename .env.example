# ---- LLM (Claude) ---------------------------------------------------------
ANTHROPIC_API_KEY=
# 역할별 모델·effort(기본: claude-opus-5-5, 분석 medium / 대본 high). 비용을 줄이려면 분석을 claude-sonnet-5-5로.
STUDIO_MODEL_ANALYSIS=claude-opus-5-5
STUDIO_MODEL_SCRIPT=claude-opus-5-5
STUDIO_EFFORT_ANALYSIS=medium
STUDIO_EFFORT_SCRIPT=high
# 안전 분류기 거절 시 서버측 대체 모델 사용(1) / 끄기(0)
STUDIO_LLM_FALLBACKS=1
# 키 없이 휴리스틱으로만 돌리기: offline
# STUDIO_LLM=offline

# ---- 네이버 (뉴스 검색·이미지 검색, 데이터랩 2차) ----------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER API HUB 등으로 호스트·헤더 이름이 바뀌면 교체
# NAVER_API_BASE=https://openapi.naver.com
# NAVER_HEADER_ID=X-Naver-Client-Id
# NAVER_HEADER_SECRET=X-Naver-Client-Secret

# ---- YouTube Data API v3 (경쟁 채널·내 채널 통계, 영상 검색) -----------------
YOUTUBE_API_KEY=

# ---- Google Custom Search JSON API (기존 키가 있을 때만; 2027-01-01 종료) -----
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---- 공공데이터 (2차) -------------------------------------------------------
DATA_GO_KR_KEY=
ASSEMBLY_API_KEY=

# ---- 기타 -----------------------------------------------------------------
# Wikimedia User-Agent 정책용 연락처
STUDIO_CONTACT=you@example.com
# 출처 자막 PNG용 한글 폰트(자동 탐색 실패 시)
# STUDIO_FONT=/Library/Fonts/NanumGothic.ttf
